{
  "name": "glossy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:next": "next dev",
    "dev:tina": "tinacms dev -c \"next dev -p 3000 -H 0.0.0.0\"",
    "start": "next start -p 3000",
    "sync:dictionary": "node scripts/sync-dictionary.mjs",
    "compile:content": "node scripts/compile-tex-to-content.mjs",
    "compile:beowulf": "node scripts/compile-beowulf.mjs",
    "prebuild": "npm run sync:dictionary && npm run compile:content && npm run compile:beowulf && npm run build:tina",
    "build": "NODE_ENV=production next build",
    "build:tina": "tinacms build --skip-cloud-checks --datalayer-port 9123",
    "build:tina:cloud": "tinacms build",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "npm run build:cf && opennextjs-cloudflare preview",
    "deploy": "npm run build:cf && wrangler deploy",
    "lint": "eslint .",
    "audit:deadcode": "knip",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:lemmas": "node scripts/validate-lemmas.mjs",
    "validate:source": "node scripts/validate-source.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tinacms/cli": "^3.1.0",
    "@tinacms/mdx": "^2.3.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.50.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tinacms": "^3.14.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.8",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.27",
    "knip": "^6.39.0",
    "typescript": "5.9.2",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
