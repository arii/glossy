{
  "name": "glossy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "dev:next": "next dev",
    "dev:tina": "tinacms dev -c \"next dev\"",
    "build": "next build",
    "build:tina": "tinacms build --local --skip-cloud-checks",
    "build:tina:cloud": "tinacms build",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:source": "node scripts/validate-source.mjs"
  },
  "dependencies": {
    "@tinacms/cli": "^3.1.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tinacms": "^3.14.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.27",
    "typescript": "5.9.2"
  }
}
