{
  "name": "glossy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:next": "next dev",
    "dev:tina": "tinacms dev -c \"next dev -p 3000 -H 0.0.0.0\"",
    "start": "next start -p 3000",
    "sync:dictionary": "node scripts/sync-dictionary.mjs",
    "compile:content": "node scripts/compile-tex-to-content.mjs",
    "prebuild": "npm run sync:dictionary && npm run compile:content && npm run build:tina",
    "build": "NODE_ENV=production next build",
    "build:tina": "tinacms build --local --skip-cloud-checks",
    "build:tina:cloud": "tinacms build",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:source": "node scripts/validate-source.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tinacms/cli": "^3.1.0",
    "lucide-react": "^1.50.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tinacms": "^3.14.1"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.2",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.27",
    "typescript": "5.9.2"
  }
}
