{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}",
    "tina/config.ts"
  ],
  "ignore": [
    "scripts/archive/**"
  ],
  "ignoreDependencies": [
    "eslint-config-next",
    "slate",
    "slate-dom"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}"
  ]
}